import ipaddress
import socket
from concurrent.futures import ThreadPoolExecutor

RESEAU = ipaddress.ip_network("192.168.56.0/28")   # réseau de TES machines virtuelles
PORT = 22

def teste(ip):
    try:
        with socket.create_connection((str(ip), PORT), timeout=0.5):
            return ip, True
    except OSError:
        return ip, False

with ThreadPoolExecutor(max_workers=16) as pool:
    for ip, ouvert in pool.map(teste, RESEAU.hosts()):
        if ouvert:
            print(f"{ip} : port {PORT} ouvert")
"""
