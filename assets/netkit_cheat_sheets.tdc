// TUTODECODE NetKit Cheat Sheets — format .tdc v1

entry "ip-link-show" {
  command: "ip link show"
  description: "Lister les interfaces réseau physiques"
  category: INTERFACE
  dangerLevel: 1
  explanation: """
Affiche l'état des interfaces réseau (up/down), les adresses MAC et l'état de la couche physique.
  """
}

entry "ip-route-show" {
  command: "ip route show"
  description: "Afficher la table de routage IP"
  category: ROUTING
  dangerLevel: 1
  explanation: """
Montre comment les paquets sont acheminés hors du système et quelle est la passerelle (Gateway) par défaut.
  """
}

entry "ss-tunlp" {
  command: "ss -tunlp"
  description: "Lister les sockets réseau (remplace netstat)"
  category: PORTS
  dangerLevel: 1
  explanation: """
Affiche les statistiques des sockets TCP/UDP, les ports d'écoute et les processus associés.
  """
}

entry "tcpdump-i-any-icmp" {
  command: "tcpdump -i any icmp"
  description: "Capturer uniquement le trafic ICMP (Ping)"
  category: DIAGNOSTIC
  dangerLevel: 2
  explanation: """
Capture en temps réel les paquets Ping entrant et sortant pour débugger la connectivité.
  """
}

entry "dig-trace-domain" {
  command: "dig +trace [domain]"
  description: "Suivre la résolution DNS étape par étape"
  category: DNS
  dangerLevel: 1
  explanation: """
Parcourt toute la hiérarchie DNS (Root, TLD, Autoritaire) pour trouver l'IP d'un domaine.
  """
}

entry "nmap-pn-f-ip" {
  command: "nmap -Pn -F [IP]"
  description: "Scan de ports rapide sans ping initial"
  category: SCAN
  dangerLevel: 2
  explanation: """
Scan les 100 ports les plus courants sans vérifier si l'hôte répond au ping (utile si firewall).
  """
}

entry "mtr-report-host" {
  command: "mtr --report [host]"
  description: "Rapport combiné Ping et Traceroute"
  category: DIAGNOSTIC
  dangerLevel: 1
  explanation: """
Génère un rapport de latence et de perte de paquets pour chaque saut sur le chemin réseau.
  """
}

entry "arp-a" {
  command: "arp -a"
  description: "Afficher la table ARP (Cache IP/MAC)"
  category: INTERFACE
  dangerLevel: 1
  explanation: """
Liste les correspondances entre adresses IP locales et adresses MAC physiques connues.
  """
}

entry "iwconfig" {
  command: "iwconfig"
  description: "Configuration des interfaces WiFi"
  category: WIRELESS
  dangerLevel: 1
  explanation: """
Affiche le SSID, la fréquence, la qualité du signal et la puissance d'émission du WiFi.
  """
}

entry "nmcli-device-wifi-list" {
  command: "nmcli device wifi list"
  description: "Lister les réseaux WiFi disponibles"
  category: WIRELESS
  dangerLevel: 1
  explanation: """
Interface en ligne de commande pour NetworkManager affichant les hotspots à portée.
  """
}
