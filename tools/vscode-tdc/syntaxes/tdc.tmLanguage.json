{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TUTODECODE Script",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#triple-strings" },
    { "include": "#operators" },
    { "include": "#comments" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tdc",
          "match": "\\b(course|module|codeblock|quiz|question)\\b"
        },
        {
          "name": "variable.other.property.tdc",
          "match": "\\b(title|description|category|level|duration|icon|keywords|explanation)\\b"
        },
        {
          "name": "constant.language.tdc",
          "match": "\\b(linux|network|security|cloud|crypto|development|beginner|intermediate|advanced)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "markup.inserted.tdc",
          "match": "^\\s*\\+\\s*"
        },
        {
          "name": "markup.deleted.tdc",
          "match": "^\\s*\\-\\s*"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.tdc",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.tdc",
          "match": "\\\\."
        }
      ]
    },
    "triple-strings": {
      "name": "string.quoted.triple.tdc",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "name": "markup.heading.markdown",
          "match": "^#+\\s+.*$"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.tdc",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.tdc",
          "match": "//.*$"
        }
      ]
    }
  },
  "scopeName": "source.tdc"
}
